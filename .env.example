# OpenAI 兼容接口配置。复制此文件为 .env 后按需填写。
# 没有 API Key 时会自动使用本地模板兜底。
LLM_BACKEND=openai
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# LLM_BACKEND=litellm 时必须带 provider 前缀。
LITELLM_MODEL=deepseek/deepseek-chat

# Phoenix 可观测性。默认关闭，不影响离线运行。
PHOENIX_ENABLED=0
PHOENIX_PROJECT_NAME=interiorforge-ai
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# 产品默认只使用 API 生图；ComfyUI 仅作为隐藏的私有化适配器保留。
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=auto
IMAGE_ESTIMATED_COST_USD=0
ENABLE_COMFYUI_ADAPTER=0

# 图片结果评测。VISION_MODEL 留空时不调用视觉模型。
VISION_API_BASE=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=
VISION_IMAGE_DETAIL=low

# 任务队列：本机默认 inline；Docker 使用 Redis + RQ。
TASK_QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_NAME=interiorforge
TASK_TIMEOUT_SECONDS=600
TASK_MAX_RETRIES=2

# 0 表示不限制。成本依据 IMAGE_ESTIMATED_COST_USD 预估。
MAX_JOB_COST_USD=0
MONTHLY_IMAGE_BUDGET_USD=0

# 服务配置
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_AUTH_USER=
GRADIO_AUTH_PASSWORD=
API_SERVER_NAME=127.0.0.1
API_SERVER_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# RAG 配置。首次查询时若知识库不存在，会自动构建。
AUTO_BUILD_KNOWLEDGE_BASE=1
EMBEDDING_DEVICE=cpu
# 国内网络不稳定时可改为可访问的 Hugging Face Endpoint。
HF_ENDPOINT=https://hf-mirror.com
